+// ---------------------------------------------------------------------------
+// Fast-stop cursor acceleration tests
+// ---------------------------------------------------------------------------
+
+// Helper: simulate a sequence of mouse-move events. |positions| is a list of
+// (x, y, delta_ms) tuples — position and time elapsed since the previous call.
+// The first entry's delta_ms is elapsed since "now" (i.e. test start).
+
+TEST_F(VerticalTabStripStateControllerTest,
+       FastStopAcceleratesExpandBeforeFullDelay) {
+  pref_service()->SetInteger(prefs::kHeliumLayout,
+                             std::to_underlying(HeliumLayoutType::kVertical));
+  controller()->SetCollapsed(true);
+  controller()->SetHovered(true);
+
+  // Simulate fast movement (70 px in 20 ms = 3.5 px/ms) followed by a stop.
+  controller()->OnCursorMoved(gfx::Point(10, 200));
+  task_environment_.FastForwardBy(base::Milliseconds(20));
+  controller()->OnCursorMoved(gfx::Point(80, 200));
+  task_environment_.FastForwardBy(base::Milliseconds(20));
+  // Near-stop: only 2 px in 20 ms = 0.1 px/ms
+  controller()->OnCursorMoved(gfx::Point(82, 200));
+
+  // Tick the velocity checker (fires every 30 ms).
+  task_environment_.FastForwardBy(base::Milliseconds(30));
+
+  // Should be expanded well before the normal 300 ms delay.
+  EXPECT_TRUE(controller()->IsHoverExpanded());
+}
+
+TEST_F(VerticalTabStripStateControllerTest,
+       SlowMovementDoesNotAccelerateExpand) {
+  pref_service()->SetInteger(prefs::kHeliumLayout,
+                             std::to_underlying(HeliumLayoutType::kVertical));
+  controller()->SetCollapsed(true);
+  controller()->SetHovered(true);
+
+  // Slow drift: 5 px per 50 ms = 0.1 px/ms throughout — never "fast".
+  controller()->OnCursorMoved(gfx::Point(10, 200));
+  task_environment_.FastForwardBy(base::Milliseconds(50));
+  controller()->OnCursorMoved(gfx::Point(15, 200));
+  task_environment_.FastForwardBy(base::Milliseconds(50));
+  controller()->OnCursorMoved(gfx::Point(17, 200));
+  task_environment_.FastForwardBy(base::Milliseconds(30));  // velocity tick
+
+  // Not yet expanded (no fast movement was seen, so no acceleration).
+  EXPECT_FALSE(controller()->IsHoverExpanded());
+
+  // Normal delay should still fire eventually.
+  task_environment_.FastForwardBy(base::Milliseconds(300));
+  EXPECT_TRUE(controller()->IsHoverExpanded());
+}
+
+TEST_F(VerticalTabStripStateControllerTest,
+       VelocityTrackingStopsOncePanelExpands) {
+  pref_service()->SetInteger(prefs::kHeliumLayout,
+                             std::to_underlying(HeliumLayoutType::kVertical));
+  controller()->SetCollapsed(true);
+  controller()->SetHovered(true);
+
+  // Let the panel expand via the normal timer.
+  task_environment_.FastForwardBy(base::Milliseconds(300));
+  EXPECT_TRUE(controller()->IsHoverExpanded());
+
+  // Subsequent OnCursorMoved calls should be no-ops (timer already fired).
+  controller()->OnCursorMoved(gfx::Point(10, 200));
+  task_environment_.FastForwardBy(base::Milliseconds(30));
+  controller()->OnCursorMoved(gfx::Point(80, 200));
+  task_environment_.FastForwardBy(base::Milliseconds(30));
+  // State should remain expanded without any re-triggering.
+  EXPECT_TRUE(controller()->IsHoverExpanded());
+}
