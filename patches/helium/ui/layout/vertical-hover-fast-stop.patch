+void VerticalTabStripRegionView::OnMouseMoved(const ui::MouseEvent& event) {
+  TabStripRegionView::OnMouseMoved(event);
+  // Forward cursor position to the state controller for velocity tracking.
+  // This drives the fast-stop acceleration: if the user flicks the cursor
+  // to the sidebar and stops, the expand fires before the full delay elapses.
+  if (state_controller_) {
+    gfx::Point screen_point = event.location();
+    ConvertPointToScreen(this, &screen_point);
+    state_controller_->OnCursorMoved(screen_point);
+  }
+}
