+void VerticalTabStripStateController::OnCursorMoved(
+    const gfx::Point& screen_point) {
+  // Only track movement while the expand timer is pending. Once expanded (or
+  // not going to expand), velocity data is irrelevant.
+  if (!hover_expand_timer_.IsRunning()) {
+    if (!cursor_samples_.empty()) {
+      cursor_samples_.clear();
+      cursor_velocity_timer_.Stop();
+    }
+    return;
+  }
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  cursor_samples_.push_back({screen_point, now});
+
+  // Evict samples older than the window.
+  while (cursor_samples_.size() > 1) {
+    const base::TimeDelta age = now - cursor_samples_.front().timestamp;
+    if (age.InMilliseconds() > static_cast<int64_t>(kVelocitySampleWindowMs)) {
+      cursor_samples_.pop_front();
+    } else {
+      break;
+    }
+  }
+  // Also cap by count to bound memory usage.
+  while (cursor_samples_.size() > kMaxVelocitySamples) {
+    cursor_samples_.pop_front();
+  }
+
+  // Start the periodic velocity checker if not already running.
+  if (!cursor_velocity_timer_.IsRunning()) {
+    cursor_velocity_timer_.Start(
+        FROM_HERE, base::Milliseconds(30), this,
+        &VerticalTabStripStateController::MaybeAccelerateHoverExpand);
+  }
+}
+
+void VerticalTabStripStateController::MaybeAccelerateHoverExpand() {
+  // Stop checking once the expand timer is no longer pending.
+  if (!hover_expand_timer_.IsRunning()) {
+    cursor_velocity_timer_.Stop();
+    cursor_samples_.clear();
+    return;
+  }
+
+  // Need at least two samples to compute velocity.
+  if (cursor_samples_.size() < 2) {
+    return;
+  }
+
+  // Compute instantaneous speed between the two most recent samples.
+  const CursorSample& prev = cursor_samples_[cursor_samples_.size() - 2];
+  const CursorSample& curr = cursor_samples_.back();
+  const double dx = curr.position.x() - prev.position.x();
+  const double dy = curr.position.y() - prev.position.y();
+  const double dist = std::sqrt(dx * dx + dy * dy);
+  const double dt_ms = (curr.timestamp - prev.timestamp).InMillisecondsF();
+  if (dt_ms < 0.5) {
+    return;
+  }
+  const double current_speed = dist / dt_ms;
+
+  // Only accelerate if the cursor has clearly stopped (current speed is low).
+  if (current_speed >= kStopSpeedThresholdPxPerMs) {
+    return;
+  }
+
+  // Check whether any earlier sample-to-sample interval was "fast", indicating
+  // a deliberate flick-and-stop gesture rather than a slow drift.
+  bool had_fast_movement = false;
+  for (size_t i = 0; i + 1 < cursor_samples_.size(); ++i) {
+    const double sdx =
+        cursor_samples_[i + 1].position.x() - cursor_samples_[i].position.x();
+    const double sdy =
+        cursor_samples_[i + 1].position.y() - cursor_samples_[i].position.y();
+    const double sdist = std::sqrt(sdx * sdx + sdy * sdy);
+    const double sdt =
+        (cursor_samples_[i + 1].timestamp - cursor_samples_[i].timestamp)
+            .InMillisecondsF();
+    if (sdt > 0.5 && (sdist / sdt) >= kFastSpeedThresholdPxPerMs) {
+      had_fast_movement = true;
+      break;
+    }
+  }
+
+  if (!had_fast_movement) {
+    return;
+  }
+
+  // Fast-then-stopped: fire the expand immediately.
+  cursor_velocity_timer_.Stop();
+  cursor_samples_.clear();
+  hover_expand_timer_.Stop();
+  OnHoverExpandDelayElapsed();
+}
